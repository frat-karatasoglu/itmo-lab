# Переменные окружения для docker compose (ЛР 2).
# Файл лежит в репозитории, потому что этого требует задание.
# В реальном проекте в git хранят только .env.example без настоящих паролей.

# --- PostgreSQL (используются образом postgres и приложением) ---
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes_password

# --- Подключение приложения к БД ---
DB_HOST=db
DB_PORT=5432

# --- Публикация API наружу ---
APP_PORT=8000
